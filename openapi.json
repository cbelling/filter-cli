{
  "openapi": "3.0.0",
  "info": {
    "title": "Filter API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/v1/feed": {
      "get": {
        "operationId": "listFeedItems",
        "summary": "List feed items with filtering, sorting, and pagination",
        "tags": [
          "Feed"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "perPage",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "source",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "read",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "saved",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "connectorId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of feed items"
          }
        }
      }
    },
    "/api/v1/feed/{id}": {
      "get": {
        "operationId": "getFeedItem",
        "summary": "Get a single feed item by ID",
        "tags": [
          "Feed"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feed item details"
          }
        }
      }
    },
    "/api/v1/feed/{id}/reader": {
      "get": {
        "operationId": "getItemReader",
        "summary": "Get or build the reader article for a feed item",
        "tags": [
          "Feed"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reader article content"
          }
        }
      }
    },
    "/api/v1/feed/{id}/read": {
      "post": {
        "operationId": "markFeedItemRead",
        "summary": "Mark a feed item as read",
        "tags": [
          "Feed Actions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item marked as read"
          }
        }
      }
    },
    "/api/v1/feed/{id}/unread": {
      "post": {
        "operationId": "markFeedItemUnread",
        "summary": "Mark a feed item as unread",
        "tags": [
          "Feed Actions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item marked as unread"
          }
        }
      }
    },
    "/api/v1/feed/{id}/save": {
      "post": {
        "operationId": "saveFeedItem",
        "summary": "Save a feed item (also marks as read)",
        "tags": [
          "Feed Actions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item saved"
          }
        }
      }
    },
    "/api/v1/feed/{id}/unsave": {
      "post": {
        "operationId": "unsaveFeedItem",
        "summary": "Remove save from a feed item",
        "tags": [
          "Feed Actions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item unsaved"
          }
        }
      }
    },
    "/api/v1/feed/{id}/archive": {
      "post": {
        "operationId": "archiveFeedItem",
        "summary": "Archive a feed item",
        "tags": [
          "Feed Actions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item archived"
          }
        }
      }
    },
    "/api/v1/feed/{id}/unarchive": {
      "post": {
        "operationId": "unarchiveFeedItem",
        "summary": "Unarchive a feed item",
        "tags": [
          "Feed Actions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item unarchived"
          }
        }
      }
    },
    "/api/v1/feed/{id}/library": {
      "post": {
        "operationId": "addToLibrary",
        "summary": "Add a feed item to the library",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item added to library"
          }
        }
      }
    },
    "/api/v1/feed/{id}/tags": {
      "patch": {
        "operationId": "updateFeedItemTags",
        "summary": "Add, remove, or replace topic tags on a feed item using tag names",
        "tags": [
          "Feed"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tags": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "set",
                      "add",
                      "remove"
                    ]
                  },
                  "createUnknown": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated tag assignments for the feed item"
          }
        }
      }
    },
    "/api/v1/highlights": {
      "get": {
        "operationId": "listHighlights",
        "summary": "List all highlights for the current user",
        "tags": [
          "Highlights"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "topic",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "color",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "feedItemId",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of highlights"
          }
        }
      }
    },
    "/api/v1/sources": {
      "get": {
        "operationId": "listSources",
        "summary": "List all content sources (connectors) for the current user",
        "tags": [
          "Sources"
        ],
        "responses": {
          "200": {
            "description": "List of sources with status and stats"
          }
        }
      },
      "post": {
        "operationId": "createSource",
        "summary": "Create a new content source (connector)",
        "tags": [
          "Sources"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "x",
                      "reddit",
                      "rss",
                      "podcast",
                      "youtube"
                    ]
                  },
                  "configKey": {
                    "type": "string"
                  },
                  "configJson": {
                    "type": "string"
                  },
                  "feedUrl": {
                    "type": "string"
                  },
                  "youtubeUrl": {
                    "type": "string"
                  },
                  "subreddits": {
                    "type": "string"
                  },
                  "usernames": {
                    "type": "string"
                  },
                  "podcastTitle": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Source created"
          }
        }
      }
    },
    "/api/v1/sources/{id}": {
      "delete": {
        "operationId": "deleteSource",
        "summary": "Delete a source and its ingestion data",
        "tags": [
          "Sources"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Source deleted"
          }
        }
      }
    },
    "/api/v1/sources/{id}/pause": {
      "post": {
        "operationId": "pauseSource",
        "summary": "Pause a source (disable ingestion)",
        "tags": [
          "Sources"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Source paused"
          }
        }
      }
    },
    "/api/v1/sources/{id}/resume": {
      "post": {
        "operationId": "resumeSource",
        "summary": "Resume a paused source (enable ingestion)",
        "tags": [
          "Sources"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Source resumed"
          }
        }
      }
    },
    "/api/v1/sources/{id}/sync": {
      "post": {
        "operationId": "syncSource",
        "summary": "Trigger manual ingestion sync for a source",
        "tags": [
          "Sources"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sync result"
          }
        }
      }
    },
    "/api/v1/sources/{id}/items": {
      "get": {
        "operationId": "listSourceItems",
        "summary": "List feed items from a specific source",
        "tags": [
          "Sources"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated feed items for the source"
          }
        }
      }
    },
    "/api/v1/sources/{id}/test": {
      "post": {
        "operationId": "testSource",
        "summary": "Test connection for a source",
        "tags": [
          "Sources"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Test result"
          }
        }
      }
    },
    "/api/v1/views": {
      "get": {
        "operationId": "listViews",
        "summary": "List all views for the current user",
        "tags": [
          "Views"
        ],
        "responses": {
          "200": {
            "description": "List of views"
          }
        }
      },
      "post": {
        "operationId": "createView",
        "summary": "Create a new view with filter configuration",
        "tags": [
          "Views"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "topicIds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "topicNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "connectorIds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "webSearchEnabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created view"
          }
        }
      }
    },
    "/api/v1/views/{id}/feed": {
      "get": {
        "operationId": "getViewFeed",
        "summary": "Get feed items filtered by a view's configuration",
        "tags": [
          "Views"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "read",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated feed items for the view"
          }
        }
      }
    },
    "/api/v1/reports": {
      "get": {
        "operationId": "listReports",
        "summary": "List reports for the current user",
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "viewId",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "reportType",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of reports"
          }
        }
      },
      "post": {
        "operationId": "createReport",
        "summary": "Create a new report",
        "tags": [
          "Reports"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "viewId": {
                    "type": "integer"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "reportType": {
                    "type": "string",
                    "enum": [
                      "ad_hoc",
                      "scheduled",
                      "event_driven",
                      "highlight_driven"
                    ]
                  },
                  "scheduleCron": {
                    "type": "string"
                  },
                  "tone": {
                    "type": "string",
                    "enum": [
                      "concise",
                      "detailed",
                      "executive",
                      "research"
                    ]
                  },
                  "webSearchEnabled": {
                    "type": "boolean"
                  },
                  "feedItemIds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "highlightIds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created report"
          }
        }
      }
    },
    "/api/v1/reports/{id}/generate": {
      "post": {
        "operationId": "generateReport",
        "summary": "Generate AI content for a report",
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Generated report content"
          }
        }
      }
    },
    "/api/v1/reports/{id}/items": {
      "post": {
        "operationId": "addItemsToReport",
        "summary": "Add feed items or highlights to a report",
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "feedItemIds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "highlightIds": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Items added to report"
          }
        }
      }
    },
    "/api/v1/ai/discover-sources": {
      "post": {
        "operationId": "discoverSources",
        "summary": "Extract candidate feed sources from free text and optional screenshots",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discovered source candidates"
          }
        }
      }
    },
    "/api/v1/ai/parse-filter": {
      "post": {
        "operationId": "parseFilterIntent",
        "summary": "Parse natural language into structured feed filter parameters",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parsed filter intent"
          }
        }
      }
    },
    "/api/v1/ai/web-search": {
      "post": {
        "operationId": "webSearch",
        "summary": "Run a web search for up-to-date information with citations",
        "tags": [
          "AI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "allowedDomains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blockedDomains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "maxUses": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results and synthesized answer"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginApiToken",
        "summary": "Create a bearer token using email and password",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "deviceName": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Issued bearer token"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logoutApiToken",
        "summary": "Revoke the current bearer token",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Token revoked"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshApiToken",
        "summary": "Revoke the current bearer token and issue a new one",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Refreshed bearer token"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getAuthUser",
        "summary": "Get the authenticated API user for the current bearer token",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile"
          }
        }
      }
    }
  }
}
